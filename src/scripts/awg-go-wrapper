#!/bin/sh
# awg-go-wrapper — wrapper for amneziawg-go to bypass "kernel first class support"
# false detection when wg0 is already running via amneziawg-go userspace.
#
# NOTE: this version of amneziawg-go uses the kernel netlink API (not a unix
# socket file), so we wait for the interface to appear in `ip link`, NOT for
# /var/run/wireguard/<name>.sock (which is never created).

IFACE="${1:-}"

if [ -z "$IFACE" ]; then
    echo "awg-go-wrapper: interface name required" >&2
    exit 1
fi

# Find amneziawg-go binary
AWG_BIN=$(which amneziawg-go 2>/dev/null || echo "/usr/bin/amneziawg-go")

# Start amneziawg-go in background with WG_PROCESS_FOREGROUND=1
# WG_PROCESS_FOREGROUND=1 bypasses the "kernel first class support" exit check
WG_PROCESS_FOREGROUND=1 "${AWG_BIN}" "${IFACE}" >/tmp/awg-${IFACE}.log 2>&1 &

# Wait up to 10s for the interface to appear in ip link
# (amneziawg-go uses kernel netlink API — no socket file is created)
i=0
while [ $i -lt 20 ]; do
    ip link show "${IFACE}" > /dev/null 2>&1 && exit 0
    sleep 0.5
    i=$((i + 1))
done

echo "awg-go-wrapper: timeout waiting for interface ${IFACE}" >&2
exit 1
